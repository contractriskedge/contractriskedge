{
  "title": "ContractRiskEdge — Tenant Isolation Metrics",
  "uid": "cre-tenant-isolation",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["contractriskedge", "tenants", "isolation"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "title": "Requests by Tenant (Top 20)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "topk(20, sum by (tenant_id) (rate(http_requests_total{environment=~\"$env\"}[5m])))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "title": "Rate Limit Hits by Tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(rate_limit_hits_total{environment=~\"$env\"}[5m]))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "title": "Tenant Error Rate Distribution",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(http_requests_total{environment=~\"$env\", status_code=~\"5..\"}[5m])) / sum by (tenant_id) (rate(http_requests_total{environment=~\"$env\"}[5m]))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "title": "Cross-Tenant Access Attempts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(cross_tenant_access_attempts_total{environment=~\"$env\"}[24h]))",
          "legendFormat": "Total Attempts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "title": "Per-Tenant Resource Consumption (CPU)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "topk(10, sum by (tenant_id) (rate(container_cpu_usage_seconds_total{environment=~\"$env\"}[1m])))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "title": "Tenant Fairness Index (Gini)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "1 - (sum by (tenant_id) (rate(http_requests_total{environment=~\"$env\"}[5m])) / count(tenant_id))",
          "legendFormat": "Fairness"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": { "steps": [{ "color": "red" }, { "color": "orange", "value": 0.3 }, { "color": "green", "value": 0.7 }] }
        }
      }
    }
  ]
}
