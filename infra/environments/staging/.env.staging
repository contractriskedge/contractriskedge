# ContractRiskEdge Staging Environment
# =============================================================================
# Staging environment — mirrors production at reduced scale.
# Uses cheaper AI models for cost efficiency.
# =============================================================================

# ── Application ───────────────────────────────────────────────────
APP_ENV=staging
LOG_LEVEL=DEBUG
DEBUG=true

# ── Database ──────────────────────────────────────────────────────
DB_HOST=postgresql-rw.database.svc.cluster.local
DB_PORT=5432
DB_NAME=contractriskedge_staging
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis.cache.svc.cluster.local
REDIS_PORT=6379
REDIS_DB=1
REDIS_POOL_SIZE=10

# ── Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis.cache.svc.cluster.local:6379/2
CELERY_RESULT_BACKEND=redis://redis.cache.svc.cluster.local:6379/3
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=900

# ── AI / LLM ──────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini  # Cheaper model for staging
AI_EMBEDDING_MODEL=text-embedding-3-small  # Cheaper embeddings
AI_EMBEDDING_DIMENSIONS=512
AI_MAX_TOKENS=32000
AI_MAX_CLAUSE_SIZE=5000
AI_TEMPERATURE=0.1
AI_FALLBACK_MODEL=gpt-4o-mini
AI_ALLOWED_MODELS=gpt-4o-mini,gpt-4o
AI_PROVIDER_FALLBACK_ORDER=openai

# ── Vector DB ─────────────────────────────────────────────────────
VECTOR_DIMENSION=512
VECTOR_INDEX_TYPE=ivfflat
VECTOR_INDEX_LISTS=50
VECTOR_SIMILARITY_THRESHOLD=0.70
VECTOR_MAX_RESULTS=10
VECTOR_RERANK_ENABLED=false

# ── Auth0 ─────────────────────────────────────────────────────────
AUTH0_DOMAIN=contractriskedge-staging.us.auth0.com
AUTH0_AUDIENCE=https://api-staging.contractriskedge.com
AUTH0_ALGORITHMS=RS256

# ── Observability ─────────────────────────────────────────────────
PROMETHEUS_MULTIPROC_DIR=/tmp
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0
OTEL_SERVICE_NAME=contractriskedge-api-staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318

# ── Security ──────────────────────────────────────────────────────
ENCRYPTION_ALGORITHM=AES-256-GCM
AUDIT_HMAC_ALGORITHM=sha256
LEGAL_HOLD_ENABLED=true
RETENTION_ENFORCEMENT_ENABLED=false  # Disabled in staging for test data preservation
SUSPICIOUS_ACTIVITY_DETECTION=true
CORS_ORIGINS=https://staging.contractriskedge.com,http://localhost:3000

# ── Multi-Tenant ──────────────────────────────────────────────────
TENANT_ISOLATION_LEVEL=shared
DEFAULT_TENANT_TIER=developer
MAX_TENANTS=50

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AI=50/minute
RATE_LIMIT_EXPORT=20/minute

# ── Storage ───────────────────────────────────────────────────────
STORAGE_BACKEND=s3
STORAGE_BUCKET=contractriskedge-staging-documents
STORAGE_REGION=us-east-1
MAX_UPLOAD_SIZE=100000000

# ── Feature Flags ─────────────────────────────────────────────────
FEATURE_REPLAY_ENGINE=true
FEATURE_EVALUATION_HARNESS=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_COMPLIANCE_AUTOMATION=false
FEATURE_CANARY_DEPLOYMENT=true
