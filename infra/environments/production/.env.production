# ContractRiskEdge Production Environment
# =============================================================================
# This file contains the production environment configuration.
# All secrets are injected via external-secrets operator / Vault.
# =============================================================================

# ── Application ───────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ── Database ──────────────────────────────────────────────────────
DB_HOST=postgresql-rw.database.svc.cluster.local
DB_PORT=5432
DB_NAME=contractriskedge
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis.cache.svc.cluster.local
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=20

# ── Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis.cache.svc.cluster.local:6379/0
CELERY_RESULT_BACKEND=redis://redis.cache.svc.cluster.local:6379/1
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# ── AI / LLM ──────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-large
AI_EMBEDDING_DIMENSIONS=1536
AI_MAX_TOKENS=128000
AI_MAX_CLAUSE_SIZE=5000
AI_TEMPERATURE=0.1
AI_FALLBACK_MODEL=gpt-4o-mini
AI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo
AI_PROVIDER_FALLBACK_ORDER=openai,anthropic

# ── Vector DB ─────────────────────────────────────────────────────
VECTOR_DIMENSION=1536
VECTOR_INDEX_TYPE=ivfflat
VECTOR_INDEX_LISTS=100
VECTOR_SIMILARITY_THRESHOLD=0.75
VECTOR_MAX_RESULTS=20
VECTOR_RERANK_ENABLED=true

# ── Auth0 ─────────────────────────────────────────────────────────
AUTH0_DOMAIN=contractriskedge.us.auth0.com
AUTH0_AUDIENCE=https://api.contractriskedge.com
AUTH0_ALGORITHMS=RS256

# ── Observability ─────────────────────────────────────────────────
PROMETHEUS_MULTIPROC_DIR=/tmp
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_SERVICE_NAME=contractriskedge-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318

# ── Security ──────────────────────────────────────────────────────
ENCRYPTION_ALGORITHM=AES-256-GCM
AUDIT_HMAC_ALGORITHM=sha256
LEGAL_HOLD_ENABLED=true
RETENTION_ENFORCEMENT_ENABLED=true
SUSPICIOUS_ACTIVITY_DETECTION=true
CORS_ORIGINS=https://app.contractriskedge.com

# ── Multi-Tenant ──────────────────────────────────────────────────
TENANT_ISOLATION_LEVEL=dedicated_collections
DEFAULT_TENANT_TIER=professional
MAX_TENANTS=1000

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AI=20/minute
RATE_LIMIT_EXPORT=10/minute

# ── Storage ───────────────────────────────────────────────────────
STORAGE_BACKEND=s3
STORAGE_BUCKET=contractriskedge-prod-documents
STORAGE_REGION=us-east-1
MAX_UPLOAD_SIZE=100000000

# ── Feature Flags ─────────────────────────────────────────────────
FEATURE_REPLAY_ENGINE=true
FEATURE_EVALUATION_HARNESS=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_COMPLIANCE_AUTOMATION=true
FEATURE_CANARY_DEPLOYMENT=false
