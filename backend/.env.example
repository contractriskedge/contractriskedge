# ── Application ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=change-this-in-production

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dev_user:dev_password@localhost:5432/contract_risk_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_S=60
DB_SLOW_QUERY_THRESHOLD_MS=500

# ── Request Limits ─────────────────────────────────────────────────
MAX_REQUEST_BODY_BYTES=100000000
MAX_UPLOAD_FILE_BYTES=100000000
REQUEST_TIMEOUT_SECONDS=30

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth0 ──────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.contractriskedge.com
AUTH0_ISSUER=https://your-tenant.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ── Development Only ───────────────────────────────────────────────
DEV_JWT_SECRET=dev-secret-change-in-production
DEV_AUTH_BYPASS=true

# ── S3 / MinIO (local MinIO on Mac, data on NAS mount) ─────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=your-minio-user
S3_SECRET_KEY=your-minio-password
S3_REGION=us-east-1
S3_BUCKET=contractrisk-documents
S3_SKIP_BUCKET_ENSURE=true

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:8000

# ── OpenTelemetry ──────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=contractrisk-api

# ── Sentry ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Celery ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
