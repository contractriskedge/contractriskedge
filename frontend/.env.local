# API base URL (uses Next.js proxy rewrite in development)
NEXT_PUBLIC_API_URL=

# Auth0 (must match backend configuration)
NEXT_PUBLIC_AUTH0_DOMAIN=dev-fvi08axao64t7euc.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=NbgzOs2k5FQT1skhHIJ3sIkiGwlfQytJ
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.contractriskedge.com

# Stripe (for frontend checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Application
NEXT_PUBLIC_APP_NAME="AI Contract Risk Analyzer"
