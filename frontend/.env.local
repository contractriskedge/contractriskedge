# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHATBOT=false

# Mock data control — set to "true" to use mock data when backend is unavailable
# Set to "false" to show errors when backend APIs fail (production mode)
NEXT_PUBLIC_USE_MOCK_DATA=true
